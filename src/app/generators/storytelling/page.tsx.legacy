 "use client";

import { useState } from "react";
import Link from "next/link";
import { createDefaultStorytellingForm, STORY_GENRES, STORY_TONES } from "@/lib/prompts/storytelling/defaults";
import type { StorytellingForm, StoryBlueprint } from "@/lib/prompts/storytelling/types";

const inputClass="w-full rounded-2xl border border-white/15 bg-[#12151c] px-5 py-4 text-[16px] font-medium text-white outline-none focus:border-cyan-400/70";
const labelClass="mb-2 block text-[15px] font-bold text-zinc-100";

export default function StorytellingPage(){
  const [form,setForm]=useState<StorytellingForm>(createDefaultStorytellingForm());
  const [result,setResult]=useState<StoryBlueprint|null>(null);
  const [loading,setLoading]=useState(false);
  const [error,setError]=useState("");

  const update=(key:keyof StorytellingForm,value:any)=>setForm(p=>({...p,[key]:value}));

  async function generate(){
    if(loading) return;
    setError("");
    setResult(null);
    setLoading(true);
    try{
      const res=await fetch("/api/storytelling",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({form})});
      const data=await res.json();
      if(!res.ok || !data.success) throw new Error(data.error || "Driacom gagal meracik cerita.");
      setResult(data.story);
    }catch(e){
      setError(e instanceof Error?e.message:"Driacom gagal meracik cerita karena sedang banyak yang menggunakan Driacom. Coba lagi beberapa saat.");
    }finally{setLoading(false);}
  }

  return <main className="min-h-screen bg-[#080a0f] text-white">
    <div className="mx-auto max-w-7xl px-5 py-8">
      <div className="mb-8 flex items-center justify-between gap-4">
        <div><p className="text-sm font-bold tracking-[0.2em] text-cyan-300">DRIACOM</p><h1 className="mt-1 text-3xl font-black">Storytelling Engine</h1><p className="mt-2 text-zinc-400">Story Director untuk cerita yang punya alur, konflik, payoff, dan continuity.</p></div>
        <Link href="/generators/storytelling-menu" className="rounded-xl border border-white/15 px-4 py-3 text-sm font-bold text-zinc-300 hover:bg-white/5">← Kembali ke Storytelling</Link>
      </div>

      <div className="grid gap-6 lg:grid-cols-[420px_1fr]">
        <section className="rounded-3xl border border-white/10 bg-white/[0.03] p-5">
          <div className="space-y-5">
            <div><label className={labelClass}>Ide cerita</label><textarea disabled={loading} value={form.idea} onChange={e=>update("idea",e.target.value)} rows={6} className={inputClass} placeholder="Contoh: CEO menyamar menjadi karyawan biasa untuk menguji kesetiaan pegawainya." /></div>
            <div><label className={labelClass}>Genre</label><select disabled={loading} value={form.genre} onChange={e=>update("genre",e.target.value)} className={inputClass}>{STORY_GENRES.map(x=><option key={x}>{x}</option>)}</select></div>
            <div><label className={labelClass}>Tone</label><select disabled={loading} value={form.tone} onChange={e=>update("tone",e.target.value)} className={inputClass}>{STORY_TONES.map(x=><option key={x}>{x}</option>)}</select></div>
            <div><label className={labelClass}>Tema (opsional)</label><input disabled={loading} value={form.theme} onChange={e=>update("theme",e.target.value)} className={inputClass} placeholder="Contoh: kesetiaan lebih penting daripada status." /></div>
            <div><label className={labelClass}>Kompleksitas</label><div className="grid grid-cols-3 gap-2">{(["Simple","Medium","Complex"] as const).map(x=><button disabled={loading} key={x} onClick={()=>update("complexity",x)} className={`rounded-xl border px-3 py-3 text-sm font-bold ${form.complexity===x?"border-cyan-400 bg-cyan-400/15 text-cyan-100":"border-white/10 bg-white/[0.03] text-zinc-300"}`}>{x}</button>)}</div></div>
            <div><label className={labelClass}>Jumlah scene</label><input disabled={loading} type="number" min={3} max={20} value={form.scenes} onChange={e=>update("scenes",e.target.value)} className={inputClass}/><p className="mt-2 text-xs text-zinc-500">Driacom tetap menyesuaikan jumlah scene dengan kompleksitas.</p></div>
            <div><label className={labelClass}>Ending</label><input disabled={loading} value={form.ending} onChange={e=>update("ending",e.target.value)} className={inputClass}/></div>
            <div className="grid grid-cols-2 gap-3"><label className="flex items-center gap-3 rounded-xl border border-white/10 p-3 text-sm font-bold"><input disabled={loading} type="checkbox" checked={form.narrator} onChange={e=>update("narrator",e.target.checked)}/> Narator</label><label className="flex items-center gap-3 rounded-xl border border-white/10 p-3 text-sm font-bold"><input disabled={loading} type="checkbox" checked={form.dialogue} onChange={e=>update("dialogue",e.target.checked)}/> Dialog</label></div>
            <div><label className={labelClass}>Arahan tambahan</label><textarea disabled={loading} value={form.extraDirection} onChange={e=>update("extraDirection",e.target.value)} rows={3} className={inputClass} placeholder="Tambahan aturan cerita..." /></div>
            <button disabled={loading || !form.idea.trim()} onClick={generate} className="w-full rounded-2xl bg-cyan-400 px-5 py-4 font-black text-black disabled:cursor-not-allowed disabled:opacity-40">{loading?"Driacom sedang meracik cerita...":"✨ Racik Storytelling"}</button>
            {error&&<div className="rounded-2xl border border-red-400/30 bg-red-400/10 p-4 text-sm text-red-200">{error}</div>}
          </div>
        </section>

        <section className="min-h-[700px] rounded-3xl border border-white/10 bg-white/[0.03] p-6">
          {!result && !loading && <div className="flex h-full min-h-[650px] items-center justify-center text-center"><div><div className="text-5xl">📖</div><h2 className="mt-4 text-2xl font-black">Story Blueprint</h2><p className="mt-2 max-w-md text-zinc-400">Masukkan ide sederhana. Driacom akan mengembangkannya menjadi cerita yang punya causal chain dan scene continuity.</p></div></div>}
          {loading&&<div className="flex min-h-[650px] items-center justify-center text-center"><div><div className="animate-pulse text-5xl">🧠</div><h2 className="mt-4 text-xl font-black">Story Director sedang bekerja...</h2><p className="mt-2 text-zinc-400">Form dikunci sampai proses selesai.</p></div></div>}
          {result&&<div className="space-y-7">
            <div><p className="text-xs font-bold uppercase tracking-widest text-cyan-300">Story Blueprint</p><h2 className="mt-2 text-3xl font-black">{result.title}</h2><p className="mt-2 text-zinc-300">{result.logline}</p></div>
            <div className="grid gap-3 md:grid-cols-2"><Info title="Hook" text={result.hook}/><Info title="Konflik" text={result.centralConflict}/><Info title="Turning Point" text={result.turningPoint}/><Info title="Climax" text={result.climax}/></div>
            <div><h3 className="mb-3 text-xl font-black">Character DNA</h3><div className="grid gap-3 md:grid-cols-2">{result.characters.map(c=><div key={c.id} className="rounded-2xl border border-white/10 bg-black/20 p-4"><p className="font-black text-cyan-200">{c.id} — {c.name}</p><p className="mt-1 text-xs text-zinc-500">{c.role}</p><p className="mt-3 text-sm text-zinc-300">{c.appearance}</p><p className="mt-2 text-sm text-zinc-400"><b>Goal:</b> {c.goal}</p><p className="mt-2 text-sm text-zinc-400"><b>Signature:</b> {c.visualSignature}</p></div>)}</div></div>
            <div><h3 className="mb-3 text-xl font-black">Scene Director</h3><div className="space-y-4">{result.scenes.map(s=><article key={s.sceneNumber} className="rounded-2xl border border-white/10 bg-black/20 p-5"><div className="flex flex-wrap items-center justify-between gap-2"><h4 className="font-black text-cyan-200">SCENE {s.sceneNumber} — {s.title}</h4><span className="text-xs text-zinc-500">{s.location} • {s.time}</span></div><p className="mt-3 text-sm text-zinc-300">{s.purpose}</p><div className="mt-4 grid gap-3 md:grid-cols-2"><Info title="Action" text={s.action}/><Info title="Reaction" text={s.reaction}/><Info title="Dialogue" text={s.dialogue || "—"}/><Info title="Narration" text={s.narration || "—"}/><Info title="End State" text={s.endState}/><Info title="Continuity" text={s.continuity}/></div><details className="mt-4"><summary className="cursor-pointer text-sm font-bold text-cyan-300">Lihat Image Prompt + Video Prompt</summary><div className="mt-3 space-y-3"><pre className="whitespace-pre-wrap rounded-xl bg-black/40 p-4 text-xs text-zinc-300">{s.imagePrompt}</pre><pre className="whitespace-pre-wrap rounded-xl bg-black/40 p-4 text-xs text-zinc-300">{s.videoPrompt}</pre></div></details></article>)}</div></div>
          </div>}
        </section>
      </div>
    </div>
  </main>
}

function Info({title,text}:{title:string;text:string}){return <div className="rounded-xl border border-white/10 bg-black/20 p-4"><p className="text-xs font-bold uppercase tracking-wider text-zinc-500">{title}</p><p className="mt-2 text-sm leading-6 text-zinc-300">{text||"—"}</p></div>}
