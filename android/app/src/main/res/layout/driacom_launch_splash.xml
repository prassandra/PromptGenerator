<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/driacomLaunchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/driacomLaunchLogo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/driacom_logo_white" />

        <TextView
            android:id="@+id/driacomLaunchWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="Selamat datang di driacom.com"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/driacomLaunchSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:alpha="0"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="prompt ai generator"
            android:textColor="#A8A8A8"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/driacomLaunchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="150dp"
            android:layout_height="3dp"
            android:layout_marginTop="34dp"
            android:alpha="0"
            android:max="100"
            android:progress="0"
            android:indeterminate="false" />

    </LinearLayout>
</FrameLayout>
