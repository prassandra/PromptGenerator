    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/supabase-js": "^2.112.3",
    "express": "^5.2.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@cloudflare/workers-types": "^5.20260829.1",
