dow-lg shadow-black/10 backdrop-blur-xl transition hover:border-cyan-400/35 hover:bg-cyan-400/[0.05] hover:text-white active:scale-[0.98] sm:min-h-11 sm:rounded-2xl sm:px-4 sm:py-3 sm:text-sm\" aria-label=\"Kembali ke Dashboard\"><span class=\"text-base leading-none\" aria-hidden=\"true\">←</span><span>Kembali</span></button><label class=\"flex shrink-0 items-center gap-2 rounded-xl border border-white/10 bg-[#090e16]/95 px-3 py-2 text-xs font-bold text-zinc-300 backdrop-blur-xl \"><span>🌐</span><span class=\"hidden md:inline\">Pilih Bahasa</span><select class=\"cursor-pointer bg-transparent text-xs font-black text-white outline-none\" aria-label=\"Pilih bahasa\"><option value=\"id\" class=\"bg-[#090e16]\" selected=\"\">🇮🇩 Indonesia</option><option value=\"en\" class=\"bg-[#090e16]\">🇬🇧 English</option></select></label></div></div></header><div class=\"w-full px-5 py-7 sm:px-8 sm:py-9 lg:px-10\"><div class=\"workspace-two-col grid gap-6 xl:gap-7\"><section class=\"workspace-form rounded-3xl border border-white/[0.08] bg-[#090e16] p-5 sm:p-6\"><div class=\"mb-6\"><h2 class=\"text-2xl font-black\">Racik Konten</h2><p class=\"mt-2 text-sm leading-6 text-zinc-500\">Field opsional boleh kosong. Driacom tetap mengisi angle, naskah, motion text, dan detail produksi secara otomatis.</p></div><div class=\"space-y-5\"><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Jenis Konten Affiliate</label><div class=\"relative\"><button type=\"button\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d] flex items-center justify-between gap-3 text-left disabled:opacity-45\"><span class=\"truncate\">UGC Natural</span><span class=\"text-zinc-500\">⌄</span></button></div></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Upload Foto Produk</label><div class=\"relative rounded-2xl border border-dashed border-white/15 bg-[#0b1018] p-3\"><label class=\"group block cursor-pointer transition hover:border-amber-300/40\"><div class=\"flex items-center gap-3\"><span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-300/15 bg-amber-300/[0.05] text-amber-300\">＋</span><span class=\"min-w-0\"><span class=\"block truncate text-sm font-bold text-zinc-200\">Pilih foto reference</span><span class=\"block text-xs text-zinc-600\">JPG, PNG, WEBP • maksimal 8 MB</span></span></div><input type=\"file\" accept=\"image/*\" class=\"hidden\"/></label></div></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Nama Produk</label><input placeholder=\"Contoh: Cat Ear Headset P47\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d]\" value=\"\"/></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Brand / Merk</label><input placeholder=\"Contoh: Driacom Audio\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d]\" value=\"\"/></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Upload Background / Lokasi</label><div class=\"relative rounded-2xl border border-dashed border-white/15 bg-[#0b1018] p-3\"><label class=\"group block cursor-pointer transition hover:border-amber-300/40\"><div class=\"flex items-center gap-3\"><span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-300/15 bg-amber-300/[0.05] text-amber-300\">＋</span><span class=\"min-w-0\"><span class=\"block truncate text-sm font-bold text-zinc-200\">Pilih foto reference</span><span class=\"block text-xs text-zinc-600\">JPG, PNG, WEBP • maksimal 8 MB</span></span></div><input type=\"file\" accept=\"image/*\" class=\"hidden\"/></label></div><p class=\"mt-2 text-xs leading-5 text-zinc-600\">Reference background dipakai sebagai source of truth agar lingkungan, layout, warna, dan elemen utama tetap konsisten.</p></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Deskripsi Background / Lokasi</label><input placeholder=\"Contoh: kamar tidur, kamar hotel, depan cermin, ruang tamu...\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d]\" value=\"\"/></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Hal yang Wajib Ditampilkan (opsional)</label><textarea rows=\"3\" placeholder=\"Contoh: kemasan, tekstur, tombol, LED RGB, detail material...\" class=\"w-full resize-none rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-4 text-[15px] leading-7 font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d]\"></textarea></div><div class=\"rounded-2xl border border-white/[0.08] bg-black/10 p-4\"><p class=\"text-[10px] font-black tracking-[0.18em] text-amber-300\">SIAPA / APA YANG TAMPIL</p><div class=\"mt-3 grid gap-2 sm:grid-cols-2\"><button type=\"button\" class=\"rounded-2xl border px-4 py-3 text-left transition border-amber-300/35 bg-amber-300/[0.07]\"><div class=\"text-sm font-bold text-amber-200\">POV Tangan</div><div class=\"mt-1 text-[11px] leading-4 text-zinc-600\">Tanpa Master Character Sheet</div></button><button type=\"button\" class=\"rounded-2xl border px-4 py-3 text-left transition border-white/10 bg-white/[0.02] hover:bg-white/[0.04]\"><div class=\"text-sm font-bold text-zinc-300\">Pakai Karakter</div><div class=\"mt-1 text-[11px] leading-4 text-zinc-600\">Upload reference karakter; Driacom meracik master sheet</div></button></div></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Apa yang Mau Diiklankan? (opsional)</label><textarea rows=\"4\" placeholder=\"Contoh: tunjukkan tekstur produk, cara pakai, dan kenapa aku suka hasil akhirnya.\" class=\"w-full resize-none rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-4 text-[15px] leading-7 font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d]\"></textarea><p class=\"mt-2 text-xs leading-5 text-zinc-600\">Kosong pun aman. Driacom menentukan angle terbaik berdasarkan produk.</p></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Gaya Suara</label><div class=\"relative\"><button type=\"button\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d] flex items-center justify-between gap-3 text-left disabled:opacity-45\"><span class=\"truncate\">Natural</span><span class=\"text-zinc-500\">⌄</span></button></div></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Motion Text</label><div class=\"grid grid-cols-2 gap-2\"><button type=\"button\" class=\"rounded-2xl border px-4 py-3 text-left transition border-amber-300/35 bg-amber-300/[0.07]\"><div class=\"text-sm font-bold text-amber-200\">Ya</div></button><button type=\"button\" class=\"rounded-2xl border px-4 py-3 text-left transition border-white/10 bg-white/[0.02] hover:bg-white/[0.04]\"><div class=\"text-sm font-bold text-zinc-300\">Tidak</div></button></div></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Gaya Motion Text</label><div class=\"relative\"><button type=\"button\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d] flex items-center justify-between gap-3 text-left disabled:opacity-45\"><span class=\"truncate\">Dinamic</span><span class=\"text-zinc-500\">⌄</span></button></div><p class=\"mt-2 text-xs leading-5 text-zinc-600\">Driacom membaca alur konten dan memilih highlight text per beat: hook, produk, benefit, hasil, dan CTA. Maksimal 1–4 kata per kemunculan; tanpa text box, badge, atau label nama style.</p></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Audio</label><div class=\"relative\"><button type=\"button\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d] flex items-center justify-between gap-3 text-left disabled:opacity-45\"><span class=\"truncate\">Narasi + BGM + Efek Suara</span><span class=\"text-zinc-500\">⌄</span></button></div></div><div class=\"rounded-2xl border border-white/[0.08] bg-black/10 p-4\"><p class=\"text-[10px] font-black tracking-[0.18em] text-amber-300\">STRUKTUR VIDEO</p><div class=\"mt-4 grid gap-4 sm:grid-cols-2\"><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Ratio</label><div class=\"relative\"><button type=\"button\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d] flex items-center justify-between gap-3 text-left disabled:opacity-45\"><span class=\"truncate\">9:16</span><span class=\"text-zinc-500\">⌄</span></button></div></div><div><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Bahasa</label><div class=\"relative\"><button type=\"button\" class=\"w-full rounded-2xl border border-white/10 bg-[#0b1018] px-4 py-3.5 text-[15px] font-medium text-white outline-none transition placeholder:text-zinc-600 focus:border-amber-300/60 focus:bg-[#0d131d] flex items-center justify-between gap-3 text-left disabled:opacity-45\"><span class=\"truncate\">Bahasa Indonesia</span><span class=\"text-zinc-500\">⌄</span></button></div></div></div><div class=\"mt-4\"><div class=\"flex items-center justify-between gap-3\"><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Jumlah Scene</label><span class=\"rounded-lg border border-amber-300/20 bg-amber-300/[0.06] px-2.5 py-1 text-xs font-black text-amber-200\">4<!-- --> scene</span></div><input type=\"range\" min=\"1\" max=\"10\" step=\"1\" class=\"mt-3 w-full accent-amber-300\" value=\"4\"/><div class=\"mt-1 flex justify-between text-[10px] text-zinc-600\"><span>1</span><span>10</span></div></div><div class=\"mt-4\"><label class=\"mb-2 block text-[13px] font-bold text-zinc-200\">Durasi per Scene</label><div class=\"grid grid-cols-4 gap-2\"><button type=\"button\" class=\"rounded-xl border px-2 py-3 text-xs font-black border-white/10 bg-white/[0.02] text-zinc-400\">4<!-- -->s</button><button type=\"button\" class=\"rounded-xl border px-2 py-3 text-xs font-black border-white/10 bg-white/[0.02] text-zinc-400\">6<!-- -->s</button><button type=\"button\" class=\"rounded-xl border px-2 py-3 text-xs font-black border-amber-300/60 bg-amber-300/[0.12] text-amber-100\">8<!-- -->s</button><button type=\"button\" class=\"rounded-xl border px-2 py-3 text-xs font-black border-white/10 bg-white/[0.02] text-zinc-400\">10<!-- -->s</button></div></div></div><div class=\"grid grid-cols-3 gap-2 text-center\"><div class=\"rounded-xl border border-white/[0.07] bg-black/15 px-2 py-3\"><div class=\"text-lg font-black text-white\">4</div><div class=\"mt-1 text-[9px] font-black tracking-[0.12em] text-zinc-600\">SCENE</div></div><div class=\"rounded-xl border border-white/[0.07] bg-black/15 px-2 py-3\"><div class=\"text-lg font-black text-white\">2s</div><div class=\"mt-1 text-[9px] font-black tracking-[0.12em] text-zinc-600\">/ SHOT</div></div><div class=\"rounded-xl border border-white/[0.07] bg-black/15 px-2 py-3\"><div class=\"text-lg font-black text-white\">32s</div><div cla